# AffordGrasp 파이프라인 설정 파일
#
# run_affordgrasp_pipeline.sh 실행 시 자동으로 읽힌다.
# 값을 바꾼 뒤 스크립트를 다시 실행하면 바로 적용된다.
# 이 파일의 값이 셸에서 미리 export한 환경변수보다 우선한다.
#
# API 키는 이 파일에 넣지 말 것 (git에 커밋되는 파일이다).
# 키는 셸 환경변수(GEMINI_API_KEY, OPENAI_API_KEY) 또는
# affordgrasp_icar/local_config.py에 설정한다.

# ICAR API provider: gemini 또는 openai
export AFFORDGRASP_PROVIDER=gemini

# ICAR 모델 (비우거나 주석 처리하면 provider 기본값 사용:
# openai=gpt-5.6-terra, gemini=gemini-3.6-flash)
# export AFFORDGRASP_MODEL=

# ICAR 결과를 grounding으로 넘길 최소 confidence (안전 게이트)
export AFFORDGRASP_MIN_CONFIDENCE=0.70

# Object Localization: top-k 후보에 포함할 최소 VLPart score
export AFFORDGRASP_OBJECT_THRESHOLD=0.01

# Object Localization: Gemini가 재선택할 후보 수
# 대상이 top_k_candidates.png에 없으면 15~20으로 올린다.
export AFFORDGRASP_OBJECT_TOP_K=10

# 후보 선택 방식: gemini-top-k 또는 vlpart-score(API 없이 최고점 선택)
export AFFORDGRASP_SELECTION_METHOD=gemini-top-k

# top-k 재선택에 사용할 Gemini 모델
export AFFORDGRASP_SELECTOR_MODEL=gemini-3.6-flash

# Gemini 후보 선택을 통과시킬 최소 confidence
export AFFORDGRASP_SELECTOR_CONFIDENCE=0.55

# Gemini 후보 선택 요청 timeout (초)
export AFFORDGRASP_SELECTOR_TIMEOUT=60

# Affordance Mask: 최소 VLPart part score
export AFFORDGRASP_PART_THRESHOLD=0.01

# VLPart 실행 장치: cpu 또는 cuda
export AFFORDGRASP_DEVICE=cpu

# VLPart 경로 (기본값이 아닐 때만 주석 해제)
# export AFFORDGRASP_VLPART_ROOT=./VLPart
# export AFFORDGRASP_VLPART_WEIGHTS=./VLPart/models/r50_pascalpart.pth
# export AFFORDGRASP_VLPART_ENV=./VLPart/.conda
