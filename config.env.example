# AffordGrasp 파이프라인 설정 예시
#
#   cp config.env.example config.env
#
# config.env는 머신별 경로와 로봇 주소를 보관하는 로컬 전용 파일이다.
# API 키는 이 파일에 넣지 말고 GEMINI_API_KEY 또는 OPENAI_API_KEY
# 셸 환경변수로 설정한다.

# ICAR는 코드에 설정된 Gemini 무료 모델을 사용한다.
# API 키는 GEMINI_API_KEY 셸 환경변수로 제공한다.

# Object Localization
export AFFORDGRASP_OBJECT_THRESHOLD=0.01
export AFFORDGRASP_OBJECT_TOP_K=10

# 후보 선택 방식: gemini-top-k 또는 vlpart-score
export AFFORDGRASP_SELECTION_METHOD=gemini-top-k
export AFFORDGRASP_SELECTOR_MODEL=gemini-3.5-flash-lite
export AFFORDGRASP_SELECTOR_CONFIDENCE=0.55
export AFFORDGRASP_SELECTOR_TIMEOUT=60

# Affordance Mask
export AFFORDGRASP_PART_THRESHOLD=0.01

# VLPart: cpu 또는 cuda
export AFFORDGRASP_DEVICE=cuda

# 필요하면 로컬 설치 경로로 변경한다.
# export AFFORDGRASP_VLPART_ROOT=./VLPart
# export AFFORDGRASP_VLPART_WEIGHTS=./VLPart/models/r50_pascalpart.pth
export AFFORDGRASP_VLPART_ENV=/absolute/path/to/conda/envs/anygrasp

# Grasp 포인트 클라우드에 사용할 D435 depth: filtered 또는 raw
export AFFORDGRASP_GRASP_DEPTH_SOURCE=filtered

# Parallel-jaw gripper 크기(미터)
export AFFORDGRASP_MAX_GRIPPER_WIDTH=0.085
export AFFORDGRASP_GRIPPER_HEIGHT=0.03

# MinkowskiEngine CPU worker 수(24 미만 권장)
export AFFORDGRASP_OMP_NUM_THREADS=16

# AnyGrasp SDK, checkpoint, Conda 환경
export AFFORDGRASP_ANYGRASP_SDK=/absolute/path/to/anygrasp_sdk
export AFFORDGRASP_ANYGRASP_CHECKPOINT=/absolute/path/to/checkpoint_detection.tar
export AFFORDGRASP_ANYGRASP_ENV=/absolute/path/to/conda/envs/anygrasp

# 로봇 설정. TEST-NET 예시 IP를 실제 xArm 주소로 바꿔야 한다.
export AFFORDGRASP_ROBOT_IP=192.0.2.1
export AFFORDGRASP_ROBOT_CONFIG=./robot_config.json
export AFFORDGRASP_EYE_TO_HAND_CALIBRATION=./calibration/eye_to_hand.json

# 충돌 검증 완료 후 실제 이동을 시작할 수 있는 최대 시간(초)
export AFFORDGRASP_COLLISION_VALIDATION_MAX_AGE_SECONDS=300
